{
  "name": "darc",
  "productName": "Darc",
  "version": "0.1.0",
  "description": "A chrome-less Chromium browser for recording buttery-smooth website footage.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "package": "electron-packager . Darc --platform=darwin --icon=assets/icon.icns --app-bundle-id=com.rahulmiah.darc --out=dist --overwrite --ignore=\"^/dist\" --ignore=\"^/assets/logo.png\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulzmiah/Narc.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5"
  }
}
